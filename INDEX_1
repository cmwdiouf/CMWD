<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>GAINDE-AI – Détection et surveillance des fuites d’hydrocarbures offshore</title>
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
--bg:#f3f6f5;--card:#fff;--tx:#0f1f1b;--mut:#5b6b66;--ac:#0a8f6a;--bd:#d5dfdb;--crit:#c0392b;--warn:#c27c0e;--ok:#0a8f6a}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0b1517;--card:#13222a;--tx:#e8f2ef;--mut:#8fa6a0;--ac:#19c58f;--bd:#23383f;--crit:#ff6b5b;--warn:#f0b04a;--ok:#19c58f}}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*,*:before,*:after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--tx);font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;line-height:1.5}
header{padding:20px 16px 8px;max-width:1000px;margin:auto}
h1{font-size:1.5rem;margin:0}h1 span{color:var(--ac)}
.sub{color:var(--mut);margin:4px 0 0;font-size:.95rem}
nav{display:flex;gap:8px;flex-wrap:wrap;max-width:1000px;margin:12px auto;padding:0 16px}
nav button{background:var(--card);color:var(--tx);border:1px solid var(--bd);padding:9px 14px;border-radius:8px;cursor:pointer;font-size:.9rem}
nav button.on{background:var(--ac);color:#fff;border-color:var(--ac)}
main{max-width:1000px;margin:auto;padding:0 16px 40px}
.card{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:16px;margin-bottom:14px}
.card h2{margin:0 0 8px;font-size:1.05rem}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px}
.kpi{border:1px solid var(--bd);border-radius:10px;padding:10px 12px}
.kpi small{color:var(--mut);display:block}.kpi b{font-size:1.1rem}
button.act{background:var(--ac);color:#fff;border:0;padding:10px 16px;border-radius:8px;cursor:pointer;font-size:.95rem}
.tw{overflow-x:auto}table{border-collapse:collapse;width:100%;font-size:.88rem}
th,td{padding:8px 10px;border-bottom:1px solid var(--bd);text-align:left;white-space:nowrap}
th{background:var(--ac);color:#fff}
.Critique{color:var(--crit);font-weight:700}.Alerte{color:var(--warn);font-weight:700}.Normale{color:var(--ok);font-weight:700}
canvas{width:100%;height:240px;display:block}
.lg{display:flex;gap:14px;flex-wrap:wrap;font-size:.85rem;color:var(--mut);margin-top:6px}
.lg i{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:5px}
.sec{display:none}.sec.on{display:block}
.note{font-size:.82rem;color:var(--mut)}
.badge{display:inline-block;padding:2px 10px;border-radius:99px;font-size:.8rem;border:1px solid var(--bd)}
</style>
</head>
<body>
<header>
<h1>GAINDE<span>-AI</span></h1>
<p class="sub">Gestion Automatisée d’Informations et de Données Environnementales par IA<br>Plateforme de détection et de surveillance en temps réel des fuites d’hydrocarbures offshore</p>
</header>
<nav>
<button class="on" data-t="home">Accueil</button>
<button data-t="det">Détection ponctuelle</button>
<button data-t="live">Surveillance en temps réel</button>
</nav>
<main>
<section id="home" class="sec on">
<div class="card"><h2>Accès aux données</h2>
<p>Choisissez votre profil pour personnaliser l’affichage (réglementation ou opérations).</p>
<div class="grid">
<div class="kpi"><small>Gouvernement (MEPM / METE / PETROSEN)</small><b>Audit, réglementation, urgences</b></div>
<div class="kpi"><small>Société pétrolière</small><b>Efficacité, prédictif, conformité</b></div>
</div></div>
<div class="card"><h2>Pourquoi GAINDE-AI ?</h2>
<p>Une fuite non détectée coûte en quelques mois plus de 710 milliards XOF (arrêt de production, réparation, suspension de l’activité maritime). GAINDE-AI remplace la réaction tardive par une anticipation immédiate et proactive grâce aux capteurs IoT et à l’intelligence artificielle.</p>
<p class="note">Version de démonstration : les données capteurs affichées sont simulées.</p></div>
<div class="card"><h2>Sources et seuils</h2>
<div class="grid">
<div class="kpi"><small>Concentration (hydrocarbures)</small><b>&lt; 15 ppm</b></div>
<div class="kpi"><small>Température</small><b>&lt; 35 °C</b></div>
<div class="kpi"><small>Pression</small><b>100 – 180 bar</b></div>
<div class="kpi"><small>Turbidité</small><b>&lt; 25 NTU</b></div>
</div></div>
</section>

<section id="det" class="sec">
<div class="card"><h2>Détection ponctuelle</h2>
<p>Lancez une analyse IA sur les données capteurs simulées.</p>
<button class="act" id="run">Lancer l’analyse IA</button>
<p id="st" class="note"></p></div>
<div class="card tw"><table><thead><tr><th>Capteur</th><th>Emplacement (zone)</th><th>Coordonnées</th><th>Valeur</th><th>Paramètre</th><th>Probabilité IA</th><th>Statut</th></tr></thead><tbody id="tb"></tbody></table></div>
</section>

<section id="live" class="sec">
<div class="card"><h2>Surveillance en temps réel <span class="badge" id="lv">● en direct</span></h2>
<canvas id="cv" width="900" height="240"></canvas>
<div class="lg"><span><i style="background:#f0b04a"></i>Concentration (ppm)</span><span><i style="background:#3b9cff"></i>Pression (bar)</span><span><i style="background:#19c58f"></i>Température (°C)</span><span><i style="background:#c06bff"></i>Turbidité (NTU)</span></div></div>
<div class="card tw"><h2>Historique des événements récents</h2><table><thead><tr><th>Heure</th><th>Capteur</th><th>Zone</th><th>Paramètre</th><th>Valeur</th><th>Probabilité IA</th><th>État</th></tr></thead><tbody id="hs"></tbody></table></div>
</section>
</main>
<script>
var S=[
{n:"C-SENSE",z:"Têtes de puits et collecteurs",c:"14.50°N, 17.50°W",p:"Concentration",u:"ppm",lim:15,min:2,max:70},
{n:"P-PRESS",z:"Collecteurs principaux",c:"14.51°N, 17.51°W",p:"Pression",u:"bar",lo:100,hi:180,min:90,max:200},
{n:"T-TEMP",z:"Pompes et séparateurs",c:"14.52°N, 17.52°W",p:"Température",u:"°C",lim:35,min:18,max:45},
{n:"O-TURB",z:"Vannes de sécurité et pompes",c:"14.53°N, 17.53°W",p:"Turbidité",u:"NTU",lim:25,min:5,max:50}
];
function r(a,b){return a+Math.random()*(b-a)}
function ev(s,forceBad){
 var v,prob,st;
 if(s.lo){v=forceBad?r(190,200):r(110,175);var d=v>s.hi?(v-s.hi)/(s.hi*.1):(v<s.lo?(s.lo-v)/(s.lo*.1):0);}
 else{v=forceBad?r(s.lim*1.4,s.max):r(s.min,s.lim*.9);var d=v>s.lim?(v-s.lim)/s.lim:0;}
 prob=d>0?Math.min(99.9,70+d*30):Math.max(2,r(2,12));
 st=prob>85?"Critique":prob>50?"Alerte":"Normale";
 return {s:s,v:v,prob:prob,st:st};
}
function row(e){return "<tr><td>"+e.s.n+"</td><td>"+e.s.z+"</td><td>"+e.s.c+"</td><td class='"+e.st+"'>"+e.v.toFixed(2)+" "+e.s.u+"</td><td>"+e.s.p+"</td><td class='"+e.st+"'>"+e.prob.toFixed(1)+" %</td><td class='"+e.st+"'>"+e.st+"</td></tr>";}
document.getElementById("run").onclick=function(){
 var b=document.getElementById("st");b.textContent="Analyse en cours…";
 setTimeout(function(){
  var out=S.map(function(s,i){return ev(s,Math.random()<.5||i===0);}).sort(function(a,b){return b.prob-a.prob});
  document.getElementById("tb").innerHTML=out.map(row).join("");
  b.textContent="Analyse IA terminée. Consultez le tableau.";
 },700);
};
var tabs=document.querySelectorAll("nav button");
function show(t){tabs.forEach(function(b){b.classList.toggle("on",b.dataset.t===t)});
 document.querySelectorAll(".sec").forEach(function(s){s.classList.toggle("on",s.id===t)});
 try{history.replaceState(null,"","#"+t)}catch(e){}
 if(t==="live")draw();}
tabs.forEach(function(b){b.onclick=function(){show(b.dataset.t)}});
var D={c:[],p:[],t:[],u:[],h:[]},N=30;
var cols={c:"#f0b04a",p:"#3b9cff",t:"#19c58f",u:"#c06bff"};
var sc={c:[0,70],p:[90,200],t:[15,45],u:[0,50]};
function tick(){
 var c=D.c.length?D.c[D.c.length-1]:8,p=D.p.length?D.p[D.p.length-1]:140,t=D.t.length?D.t[D.t.length-1]:25,u=D.u.length?D.u[D.u.length-1]:12;
 c=Math.max(2,Math.min(65,c+r(-2,2.2)));p=Math.max(105,Math.min(178,p+r(-6,6)));
 t=Math.max(20,Math.min(34,t+r(-.8,.8)));u=Math.max(6,Math.min(24,u+r(-1.2,1.2)));
 D.c.push(c);D.p.push(p);D.t.push(t);D.u.push(u);
 for(var k in D){if(k!=="h"&&D[k].length>N)D[k].shift();}
 var s=S[Math.floor(Math.random()*4)];var e=ev(s,Math.random()<.12);
 D.h.unshift({t:new Date().toLocaleTimeString("fr-FR"),e:e});if(D.h.length>8)D.h.pop();
 document.getElementById("hs").innerHTML=D.h.map(function(x){var e=x.e;return "<tr><td>"+x.t+"</td><td>"+e.s.n+"</td><td>"+e.s.z+"</td><td>"+e.s.p+"</td><td class='"+e.st+"'>"+e.v.toFixed(2)+" "+e.s.u+"</td><td class='"+e.st+"'>"+e.prob.toFixed(1)+" %</td><td class='"+e.st+"'>"+e.st+"</td></tr>"}).join("");
 if(document.getElementById("live").classList.contains("on"))draw();
}
function draw(){
 var cv=document.getElementById("cv"),g=cv.getContext("2d"),W=cv.width,H=cv.height;
 g.clearRect(0,0,W,H);g.strokeStyle="rgba(128,150,145,.3)";g.lineWidth=1;
 for(var i=0;i<5;i++){var y=10+i*(H-20)/4;g.beginPath();g.moveTo(0,y);g.lineTo(W,y);g.stroke();}
 for(var k in cols){var a=D[k];if(a.length<2)continue;g.strokeStyle=cols[k];g.lineWidth=2.5;g.beginPath();
  a.forEach(function(v,i){var x=i*(W/(N-1)),y=H-10-((v-sc[k][0])/(sc[k][1]-sc[k][0]))*(H-20);i?g.lineTo(x,y):g.moveTo(x,y);});g.stroke();}
}
for(var i=0;i<N;i++)tick();
setInterval(tick,2000);
var h=(location.hash||"").slice(1);if(h==="det"||h==="live")show(h);
</script>
</body>
</html>
